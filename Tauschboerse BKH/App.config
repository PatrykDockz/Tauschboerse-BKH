<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Pfad zur Access-Datenbank. Relativ (zum Programmordner) oder absolut,
         z. B. Netzlaufwerk: \\server\freigabe\Tauschboerse.accdb -->
    <add key="DatenbankPfad" value="Tauschboerse.accdb" />
    <add key="DatenbankProvider" value="Microsoft.ACE.OLEDB.12.0" />

    <!-- Mailversand (Kontaktformular) über SMTP -->
    <add key="SmtpHost" value="" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpSsl" value="true" />
    <add key="SmtpBenutzer" value="" />
    <add key="SmtpPasswort" value="" />
    <add key="MailAbsender" value="tauschboerse@example.org" />
  </appSettings>
</configuration>
